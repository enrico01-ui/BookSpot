// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  CUSTOMER
}

enum UserStatus{
  ACTIVE
  SUSPENDED
  DELETE
}

enum VenueStatus{
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum OwnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MIDTRANS
  XENDIT
}

enum PricingDayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

enum NotificationType {
  BOOKING_CREATED
  PAYMENT_SUCCESS
  BOOKING_EXPIRED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUSPEND
  UNSUSPEND
  REFUND
  CHANGE_ROLE
}

enum EntityType {
  USER
  VENUE
  RESOURCE
  BOOKING
  PAYMENT
  REVIEW
}

enum OwnerApplicationDecision {
  APPROVE
  REJECT
}

model User {
  id              Int        @id @default(autoincrement())
  name            String?
  email           String     @unique
  passwordHash    String     
  phone           String?
  avatarUrl       String?    

  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?  

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  // Relations
  venues             Venue[]
  bookings           Booking[]
  refreshTokens      RefreshToken[]
  ownerApplications  OwnerApplication[]
  notifications      Notification[]
  favorites          Favorite[]
  reviews            Review[]
  auditLogs          AuditLog[]

  @@map("users")
}


model RefreshToken {
  id                 Int      @id @default(autoincrement())

  userId             Int      @map("user_id")
  tokenHash          String   @map("token_hash")

  expiresAt          DateTime @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")

  replacedByTokenId  Int?     @unique @map("replaced_by_token_id")

  createdAt          DateTime @default(now()) @map("created_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  replacedBy         RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])

  replacedTokenFrom  RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}


model OwnerApplication {
  id                Int                     @id @default(autoincrement())

  userId            Int                     @map("user_id")
  status            OwnerApplicationStatus  @default(PENDING)

  businessName      String?                 @map("business_name")
  businessDescription String?              @map("business_description")

  reviewedBy        Int?                    @map("reviewed_by")
  reviewedAt        DateTime?               @map("reviewed_at")
  rejectionReason   String?                 @map("rejection_reason")

  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  user              User                    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("owner_applications")
}



model Venue {
  id          Int         @id @default(autoincrement())

  ownerId     Int         @map("owner_id")

  name        String
  address     String
  city        String

  latitude    Decimal?    @db.Decimal(10, 7)
  longitude   Decimal?    @db.Decimal(10, 7)

  description String?
  status      VenueStatus @default(DRAFT)

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  owner           User             @relation(fields: [ownerId], references: [id])

  images          VenueImage[]
  facilities      VenueFacility[]
  operatingHours  OperatingHour[]
  closures        VenueClosure[]
  resources       Resource[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([ownerId])
  @@index([city])
  @@index([status])
  @@map("venues")
}


model VenueImage {
  id        Int      @id @default(autoincrement())

  venueId   Int      @map("venue_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("venue_images")
}


model Facility {
  id          Int             @id @default(autoincrement())

  name        String          @unique
  description String?

  venues      VenueFacility[]

  @@map("facilities")
}


model VenueFacility {
  venueId    Int @map("venue_id")
  facilityId Int @map("facility_id")

  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([venueId, facilityId])
  @@map("venue_facilities")
}


model OperatingHour {
  id        Int      @id @default(autoincrement())

  venueId   Int      @map("venue_id")
  dayOfWeek Int      @map("day_of_week")

  openTime  String   @map("open_time")
  closeTime String   @map("close_time")

  isClosed  Boolean  @default(false) @map("is_closed")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@map("operating_hours")
}


model VenueClosure {
  id        Int      @id @default(autoincrement())

  venueId   Int      @map("venue_id")

  startAt  DateTime  @map("start_at")
  endAt    DateTime  @map("end_at")
  reason   String?

  createdAt DateTime @default(now()) @map("created_at")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startAt, endAt])
  @@map("venue_closures")
}




model Resource {
  id          Int            @id @default(autoincrement())

  venueId     Int            @map("venue_id")

  name        String
  type        String
  description String?

  basePrice   Decimal        @map("base_price") @db.Decimal(12, 2)

  status      ResourceStatus @default(ACTIVE)

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  venue        Venue                  @relation(fields: [venueId], references: [id])

  pricingRules ResourcePricingRule[]
  blocks       ResourceBlock[]
  bookingItems BookingItem[]

  @@index([venueId])
  @@index([type])
  @@map("resources")
}


model ResourcePricingRule {
  id          Int             @id @default(autoincrement())

  resourceId  Int             @map("resource_id")

  dayType     PricingDayType  @map("day_type")

  startTime   String          @map("start_time")
  endTime     String          @map("end_time")

  price       Decimal         @db.Decimal(12, 2)

  resource    Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, dayType])
  @@map("resource_pricing_rules")
}


model ResourceBlock {
  id         Int      @id @default(autoincrement())

  resourceId Int      @map("resource_id")

  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")

  reason     String?

  createdAt  DateTime @default(now()) @map("created_at")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startAt, endAt])
  @@map("resource_blocks")
}




model Booking {
  id                 Int           @id @default(autoincrement())

  bookingCode        String        @unique @map("booking_code")
  customerId         Int           @map("customer_id")

  status             BookingStatus @default(PENDING)

  expiresAt          DateTime?     @map("expires_at")

  totalAmount        Decimal       @db.Decimal(12, 2) @map("total_amount")

  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason")

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer           User          @relation(fields: [customerId], references: [id])

  items              BookingItem[]
  payments           Payment[]
  review             Review?

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("bookings")
}


model BookingItem {
  id         Int      @id @default(autoincrement())

  bookingId  Int      @map("booking_id")
  resourceId Int      @map("resource_id")

  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")

  unitPrice  Decimal  @db.Decimal(12, 2) @map("unit_price")
  subtotal   Decimal  @db.Decimal(12, 2)

  createdAt  DateTime @default(now()) @map("created_at")

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  resource   Resource @relation(fields: [resourceId], references: [id])

  @@index([bookingId])
  @@index([resourceId, startAt, endAt])
  @@map("booking_items")
}



model Payment {
  id          Int             @id @default(autoincrement())

  bookingId   Int             @map("booking_id")

  provider    PaymentProvider
  externalId  String?         @map("external_id")

  status      PaymentStatus   @default(PENDING)

  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("IDR")

  paidAt      DateTime?       @map("paid_at")
  expiresAt   DateTime?       @map("expires_at")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  booking     Booking         @relation(fields: [bookingId], references: [id])

  events      PaymentEvent[]

  @@index([bookingId])
  @@index([externalId])
  @@map("payments")
}


model PaymentEvent {
  id              Int      @id @default(autoincrement())

  paymentId       Int      @map("payment_id")

  providerEventId String   @unique @map("provider_event_id")

  eventType       String   @map("event_type")
  payload         Json

  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}



model Review {
  id         Int      @id @default(autoincrement())

  bookingId  Int      @unique @map("booking_id")
  customerId Int      @map("customer_id")
  venueId    Int      @map("venue_id")

  rating     Int
  comment    String?

  ownerReply String?  @map("owner_reply")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking    Booking  @relation(fields: [bookingId], references: [id])

  customer   User     @relation(fields: [customerId], references: [id])

  venue      Venue    @relation(fields: [venueId], references: [id])

  @@index([customerId])
  @@index([venueId])
  @@map("reviews")
}


model Favorite {
  userId    Int      @map("user_id")
  venueId   Int      @map("venue_id")

  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@map("favorites")
}




model Notification {
  id        Int              @id @default(autoincrement())

  userId    Int              @map("user_id")

  type      NotificationType
  title     String
  message   String

  readAt    DateTime?        @map("read_at")

  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}



model IdempotencyKey {
  id          Int      @id @default(autoincrement())

  userId      Int?     @map("user_id")

  key         String
  endpoint    String

  responseCode Int?    @map("response_code")
  responseBody Json?   @map("response_body")

  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@unique([userId, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}




model AuditLog {
  id         Int         @id @default(autoincrement())

  actorId    Int?        @map("actor_id")

  action     AuditAction
  entityType EntityType  @map("entity_type")
  entityId   Int         @map("entity_id")

  metadata   Json?

  createdAt  DateTime    @default(now()) @map("created_at")

  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}


